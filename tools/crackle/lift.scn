# Six lift-offs at 5000 rpm for the pop baseline of just crackle-baseline:
# 3 s at full throttle to heat the exhaust, then 3 s of closed throttle on
# overrun, which starts a lift-off run of own pops.
hold 5000 1 3
hold 5000 0 3
hold 5000 1 3
hold 5000 0 3
hold 5000 1 3
hold 5000 0 3
hold 5000 1 3
hold 5000 0 3
hold 5000 1 3
hold 5000 0 3
hold 5000 1 3
hold 5000 0 3
