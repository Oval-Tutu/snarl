# v8-ls (GM LS): written by tools/fit --upstream-scenarios from the engine dump.
# 3 s holds at throttle 1, with 0.5 s sweeps between them.
hold 690 1 3
sweep 690 2000 1 0.5
hold 2000 1 3
sweep 2000 3000 1 0.5
hold 3000 1 3
sweep 3000 4000 1 0.5
hold 4000 1 3
sweep 4000 5000 1 0.5
hold 5000 1 3
sweep 5000 6000 1 0.5
hold 6000 1 3
sweep 6000 6500 1 0.5
hold 6500 1 3
